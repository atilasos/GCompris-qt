 function test_controls(){
  wait(1800);var expected=humanBoth?(gravity?1:0):(gravity?6:5);compare(activity.numberOfLevel,expected);var initial=fresh(1);evidence={publicLevels:activity.numberOfLevel,initial:initial,partial:[],keyboard:[],illegal:[],pieceKeyboardExposed:gravity};
