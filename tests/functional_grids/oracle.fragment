 function cageOK(values,target,op){if(values.length===1)return op===''&&values[0]===target;if(op==='+')return values.reduce(function(a,b){return a+b;},0)===target;if(op==='×'||op==='*')return values.reduce(function(a,b){return a*b;},1)===target;if(values.length!==2)throw new Error('Only +/× allowed for larger cages');if(op==='−'||op==='-')return Math.abs(values[0]-values[1])===target;if(['∕','÷',':','/'].indexOf(op)>=0){var a=Math.min(values[0],values[1]),b=Math.max(values[0],values[1]);return b%a===0&&b/a===target;}throw new Error('Unknown cage operator');}
 function visiblePuzzle(screen,arithmetic){var n=screen.size,cells=new Array(n*n),symbols=screen.palette.map(function(p){return p.source;});if(symbols.length!==n||new Set(symbols).size!==n||symbols.indexOf('')>=0)throw new Error('Visible palette incomplete');for(var cell of screen.cells){var c=Math.round(cell.x/cell.width),r=Math.round(cell.y/cell.height),i=r*n+c;if(c<0||c>=n||r<0||r>=n||cells[i]!==undefined)throw new Error('Ambiguous cell geometry');cells[i]=cell;}var givens=cells.map(function(cell){if(!cell.source)return 0;var index=symbols.indexOf(cell.source);if(index<0)throw new Error('Clue absent from palette');return arithmetic?Number(cell.source.split('/').pop().replace('.svg','')):index+1;});var p={n:n,givens:givens,regions:[],cages:[]};if(!arithmetic){for(var box of screen.regions){var region=[];for(var i=0;i<cells.length;i++){var cell=cells[i],x=cell.x+cell.width/2,y=cell.y+cell.height/2;if(box.x<=x&&x<box.x+box.width&&box.y<=y&&y<box.y+box.height)region.push(i);}if(region.length!==n)throw new Error('Visible region size');p.regions.push(region);}}else{var walls={},frames={};for(var frame of screen.cages){var i=Math.round(frame.y/frame.height)*n+Math.round(frame.x/frame.width),edges=[];for(var wall of frame.walls)edges.push(wall.width>wall.height?(wall.y+wall.height/2<frame.height/2?'T':'B'):(wall.x+wall.width/2<frame.width/2?'L':'R'));walls[i]=edges;frames[i]=frame;}if(Object.keys(frames).length!==n*n)throw new Error('Cage frames missing');var seen={};for(var start=0;start<n*n;start++){if(seen[start])continue;seen[start]=true;var queue=[start],group=[];while(queue.length){var cell=queue.pop(),row=Math.floor(cell/n),col=cell%n;group.push(cell);for(var step of [[cell-1,col>0,'L','R'],[cell+1,col<n-1,'R','L'],[cell-n,row>0,'T','B'],[cell+n,row<n-1,'B','T']])if(step[1]&&!seen[step[0]]&&walls[cell].indexOf(step[2])<0&&walls[step[0]].indexOf(step[3])<0){seen[step[0]]=true;queue.push(step[0]);}}var labels=[];for(var cell of group)labels=labels.concat(cells[cell].labels);if(labels.length!==1)throw new Error('Cage requires one drawn label');var match=/^(\d+)([+−×∕÷:*\/-]?)$/.exec(labels[0].replace(/ /g,''));if(!match)throw new Error('Unrecognised drawn cage label');p.cages.push({cells:group.sort(function(a,b){return a-b;}),target:Number(match[1]),op:match[2]});}}return p;}
 function puzzleUnits(p){var n=p.n,groups=p.regions.slice();for(var r=0;r<n;r++){var row=[],col=[];for(var c=0;c<n;c++){row.push(r*n+c);col.push(c*n+r);}groups.push(row);groups.push(col);}return groups;}
 function solvedVisible(p,values){var n=p.n;if(values.length!==n*n||values.some(function(v){return v<1||v>n||v!==Math.floor(v);}))return false;if(p.givens.some(function(v,i){return v&&values[i]!==v;}))return false;for(var unit of puzzleUnits(p))if(unit.length!==n||new Set(unit.map(function(i){return values[i];})).size!==n)return false;for(var cage of p.cages)if(!cageOK(cage.cells.map(function(i){return values[i];}),cage.target,cage.op))return false;return true;}
 function solveVisible(p){var n=p.n,values=p.givens.slice(),groups=puzzleUnits(p),peers=values.map(function(){return [];});if([3,4,5,9].indexOf(n)<0||values.length!==n*n)throw new Error('Invalid grid dimensions');for(var unit of groups){if(unit.length!==n)throw new Error('Invalid region');var known=unit.map(function(i){return values[i];}).filter(function(v){return v>0;});if(new Set(known).size!==known.length)throw new Error('Conflicting drawn givens');for(var i of unit)for(var j of unit)if(i!==j&&peers[i].indexOf(j)<0)peers[i].push(j);}var cages=[],byCell={};for(var cage of p.cages){var options=[];var enumerate=function(prefix){if(prefix.length===cage.cells.length){if(cageOK(prefix,cage.target,cage.op))options.push(prefix.slice());return;}var index=cage.cells[prefix.length];for(var value=1;value<=n;value++){var duplicate=false;for(var j=0;j<prefix.length;j++)if(prefix[j]===value&&peers[index].indexOf(cage.cells[j])>=0)duplicate=true;if(!duplicate)enumerate(prefix.concat([value]));}};enumerate([]);if(options.length===0)throw new Error('Impossible drawn cage');var index=cages.length;cages.push({cells:cage.cells,options:options});for(var j=0;j<cage.cells.length;j++)byCell[cage.cells[j]]=[index,j];}var candidates=function(cell){var allowed=[];for(var v=1;v<=n;v++)if(!peers[cell].some(function(i){return values[i]===v;}))allowed.push(v);if(byCell[cell]!==undefined){var ref=byCell[cell],cage=cages[ref[0]],possible=cage.options.filter(function(option){return cage.cells.every(function(i,j){return !values[i]||values[i]===option[j];});});allowed=allowed.filter(function(v){return possible.some(function(option){return option[ref[1]]===v;});});}return allowed;};var search=function(){var selected=-1,choices=null;for(var i=0;i<values.length;i++)if(values[i]===0){var possible=candidates(i);if(choices===null||possible.length<choices.length){selected=i;choices=possible;}if(possible.length===0)return null;}if(selected<0)return solvedVisible(p,values)?values.slice():null;for(var value of choices){values[selected]=value;var result=search();if(result!==null)return result;}values[selected]=0;return null;};var result=search();if(result===null)throw new Error('No solution for drawn constraints');return result;}
