TestCase {
 name:'BothWheelLevelsNaturalGeometryStopResumeAndPhysicalFiles'
 when:activity.visible&&canvasArea.width>0
 property var evidence: ({levels:[],savedFiles:[]})
 function ensure(ok,msg){if(!ok){grabImage(pageView).save('__QA_OUTPUT__/failure-scene.png');console.log('CREATION_ASSERT',msg);}verify(ok,msg);}
 function all(root,predicate){var out=[];function walk(o){if(!o)return;if(predicate(o))out.push(o);if(o.children)for(var c of o.children)walk(c);}walk(root);return out;}
 function drawn(o){if(!o||!o.visible||o.width<=0||o.height<=0)return false;for(var p=o;p;p=p.parent)if(p.visible===false||p.opacity===0)return false;var q=o.mapToItem(pageView,o.width/2,o.height/2);if(q.x<0||q.y<0||q.x>=pageView.width||q.y>=pageView.height)return false;for(var a=o.parent;a&&a!==pageView;a=a.parent)if(a.clip){var v=o.mapToItem(a,o.width/2,o.height/2);if(v.x<0||v.y<0||v.x>=a.width||v.y>=a.height)return false;}return true;}
 function find(root,p){var a=all(root,function(o){return drawn(o)&&p(o);});ensure(a.length>0,'Visible control exists');return a[0];}
 function click(o){ensure(drawn(o),'Actual click lies in rendered scene');mouseClick(o,o.width/2,o.height/2);wait(180);}
 function icon(name){var o=find(bar,function(o){return o.source!==undefined&&String(o.source).endsWith('/'+name);});click(o);wait(1900);}
 function button(root,text){click(find(root,function(o){return o.text!==undefined&&String(o.text)===text&&o.clicked!==undefined;}));}
 function box(o){var p=o.mapToItem(pageView,0,0);return {x:p.x,y:p.y,width:o.width,height:o.height};}
 function shot(name){var im=grabImage(pageView);im.save('__QA_OUTPUT__/'+name+'.png');return im;}
 function sample(im,o,x,y){var p=o.mapToItem(pageView,x,y);return String(im.pixel(Math.round(p.x),Math.round(p.y)));}
 function drag(o,x,y,dx,dy){mousePress(o,x,y);for(var i=1;i<=12;i++){mouseMove(o,x+dx*i/12,y+dy*i/12,25);wait(25);}mouseRelease(o,x+dx,y+dy);wait(700);}

 function typeText(s){for(var c of s){if(c==='Ç')keyClick(Qt.Key_Ccedilla);else if(c==='Ã')keyClick(Qt.Key_Atilde);else if(c==='Á')keyClick(Qt.Key_Aacute);else if(c==='É')keyClick(Qt.Key_Eacute);else{ensure(c.charCodeAt(0)<128,'ASCII key or explicit Qt enum only');keyClick(c);}wait(30);}}
 function saveDrawing(name){keyClick(Qt.Key_S,Qt.ControlModifier);wait(650);evidence.saveDialogVisible=creationHandler.visible;shot('save-request');tryCompare(creationHandler,'visible',true);var field=find(creationHandler,function(o){return o.placeholderText!==undefined&&o.cursorPosition!==undefined;});click(field);typeText(name);evidence.fileNameTyped=String(field.text);shot('save-name');compare(String(field.text),name);var path=String(creationHandler.sharedDirectoryPath)+name+(creationHandler.svgMode?'.svg':'.png');shot('save-dialog');button(creationHandler,'Gravar');wait(500);shot('save-success');button(creationHandler,'OK');tryCompare(creationHandler,'visible',false,5000);wait(800);return path;}
 function openDrawing(name){keyClick(Qt.Key_O,Qt.ControlModifier);tryCompare(creationHandler,'visible',true);wait(800);click(find(creationHandler,function(o){return o.text!==undefined&&o.font!==undefined&&String(o.text)===name;}));shot('open-dialog');button(creationHandler,'Carregar');tryCompare(creationHandler,'visible',false,5000);wait(1000);}
 function confirmYes(){tryCompare(newImageDialog,'active',true);wait(500);button(newImageDialog.item,'Sim');tryCompare(newImageDialog,'active',false,5000);wait(800);}
 function helpAndMenu(){var depth=pageView.depth;icon('bar_help.svg');tryCompare(pageView,'depth',depth+1);evidence.help={title:String(pageView.currentItem.title),content:String(pageView.currentItem.content)};shot('help');keyClick(Qt.Key_Escape);tryCompare(pageView,'depth',depth);wait(1900);ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(pageView,'depth',1);ensure(pageView.currentItem.isMenu,'Stable menu after saved creation');wait(1900);ensure(pageView.currentItem.isMenu);shot('menu');evidence.menu=true;}

 function numberLabel(o){return String(find(o,function(c){return c.text!==undefined&&c.font!==undefined&&/^\d+$/.test(String(c.text));}).text);}
 function choices(kind){return all(wheelPanel,function(o){return drawn(o)&&o.clicked!==undefined&&o.source!==undefined&&String(o.source).endsWith('/'+kind+'.svg');});}
 function geometry(){ensure(theWheel.visible&&theGear.visible,'Geometry measured only while gears drawn');var c=canvasArea.mapFromItem(theWheel,theWheel.width/2,theWheel.height/2),g=canvasArea.mapFromItem(theGear,theGear.width/2,theGear.height/2),p=canvasArea.mapFromItem(pencil,pencil.width/2,pencil.height/2);return {center:{x:c.x,y:c.y},gear:{x:g.x,y:g.y,rotation:theGear.rotation,width:theGear.width,height:theGear.height},pen:{x:p.x,y:p.y},canvas:box(canvasArea)};}
 function slide(o,fraction){var before=o.value;mouseClick(o,o.width*fraction,o.height/2);wait(350);return {from:o.from,to:o.to,before:before,value:o.value,step:o.stepSize,geometry:box(o)};}
 function test_levels(){wait(2500);activity.Window.window.requestActivate();wait(500);ensure(!ApplicationInfo.useSoftwareRenderer);evidence.publicLevels=activity.numberOfLevel;compare(evidence.publicLevels,2);for(var level=1;level<=2;level++){compare(bar.level,level);if(!theWheel.visible)click(hideGears);var record={level:level};evidence.levels.push(record);click(gearButton);wait(350);shot('level-'+level+'-wheel-options');if(level===1){record.fixed=[];var buttons=choices('wheel');compare(buttons.length,7);var wheels=buttons.map(function(b){return numberLabel(b);});for(var label of wheels){click(choices('wheel').filter(function(b){return numberLabel(b)===label;})[0]);var gears=choices('gear').map(function(b){return numberLabel(b);});var selected={wheel:label,gears:gears};record.fixed.push(selected);for(var gear of gears){click(choices('gear').filter(function(b){return numberLabel(b)===gear;})[0]);compare(numberLabel(gearButton),gear);}shot('wheel-'+label+'-gear-options');}click(choices('wheel').filter(function(b){return numberLabel(b)==='96';})[0]);click(choices('gear').filter(function(b){return numberLabel(b)==='30';})[0]);}else{record.wheelSlider=slide(wheelTeethSlider,.45);record.gearSlider=slide(gearTeethSlider,.35);}record.wheel=Number(wheelTeethSlider.value);record.gear=Number(gearTeethSlider.value);record.speed=slide(timerValue,.6);shot('level-'+level+'-chosen-options');click(gearButton);wait(350);click(pencilButton);wait(350);record.penSize=slide(penSizeSlider,.2);record.penOpacity=slide(penOpacitySlider,.7);record.penOffset=slide(penOffsetSlider,.5);record.toothOffset=slide(toothOffsetSlider,.6);shot('level-'+level+'-pen-options');click(pencilButton);wait(350);record.initial=geometry();shot('level-'+level+'-initial');click(playButton);ensure(String(playButton.source).endsWith('/stop.svg'),'Real play starts drawing');wait(700);record.moving=geometry();ensure(Math.abs(record.moving.pen.x-record.initial.pen.x)+Math.abs(record.moving.pen.y-record.initial.pen.y)>2,'Pen moves by normal timer');click(playButton);ensure(String(playButton.source).endsWith('/play.svg'),'Real stop stops drawing');wait(700);record.stopped=geometry();wait(700);record.still=geometry();compare(JSON.stringify(record.stopped),JSON.stringify(record.still));shot('level-'+level+'-stopped');click(playButton);var pulse=Date.now();tryVerify(function(){if(Date.now()-pulse>5000){console.log('CREATION_HEARTBEAT wheels',level,String(playButton.source));pulse=Date.now();}return String(playButton.source).endsWith('/play.svg');},90000);wait(900);record.completed=geometry();shot('level-'+level+'-completed');keyClick(Qt.Key_Z,Qt.ControlModifier);wait(800);shot('level-'+level+'-undo');keyClick(Qt.Key_Y,Qt.ControlModifier);wait(800);shot('level-'+level+'-redo');click(hideGears);shot('level-'+level+'-without-gears');record.savedPath=saveDrawing('RODAS'+level);evidence.savedFiles.push(record.savedPath);evidence.savedFiles.push(record.savedPath.replace(/\.svg$/,'.png'));shot('level-'+level+'-saved');click(fileButton);wait(350);button(filePanel,'Criar uma nova imagem');wait(800);if(newImageDialog.active)confirmYes();shot('level-'+level+'-new');openDrawing('RODAS'+level+'.svg');shot('level-'+level+'-opened');grabImage(canvasArea).save('__QA_OUTPUT__/level-'+level+'-widget-opened.png');record.reopened={canvas:box(canvasArea),wheelVisible:theWheel.visible};if(level<2){icon('bar_next.svg');if(newImageDialog.active)confirmYes();wait(500);}console.log('CREATION_PROGRESS drawing_wheels',level,2);}helpAndMenu();}
 function cleanupTestCase(){console.log('NATIVE_CREATION_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
}
