TestCase {
 name:'EveryFreeGridBackgroundMouseKeyboardEraseAndReload'
 when:activity.visible&&paintArea.width>0
 property var evidence: ({levels:[]})
__VISIBLE__
 function cell(){return find(paintGrid,function(o){return o.touched!==undefined&&o.x===0&&o.y===0;});}
 function test_levels(){wait(1900);var total=activity.numberOfLevel;compare(total,31);evidence.publicLevels=total;for(var l=1;l<=total;l++){compare(bar.level,l);var c=cell(),r={level:l,background:String(activityBackground.source),grid:box(paintGrid),cell:box(c),paletteCount:colorSelector.count};evidence.levels.push(r);compare(r.paletteCount,l<10?12:49);var initial=shot('level-'+l+'-initial');r.blank=sample(initial,c,c.width*.08,c.height*.08);click(c);var painted=shot('level-'+l+'-painted');r.mousePaint=sample(painted,c,c.width*.08,c.height*.08);compare(r.mousePaint,'#550000');keyClick(Qt.Key_Right);keyClick(Qt.Key_Return);wait(160);r.keyboard={x:cursor.x+cursor.width*.08,y:cursor.y+cursor.height*.08};var keyed=shot('level-'+l+'-keyboard');r.keyPaint=sample(keyed,paintGrid,r.keyboard.x,r.keyboard.y);compare(r.keyPaint,'#550000');keyClick(Qt.Key_Tab);keyClick(Qt.Key_Up);keyClick(Qt.Key_Tab);keyClick(Qt.Key_Left);keyClick(Qt.Key_Space);wait(160);var erased=shot('level-'+l+'-erased');r.erased=sample(erased,c,c.width*.08,c.height*.08);compare(r.erased,r.blank);icon('bar_reload.svg');c=cell();var reload=shot('level-'+l+'-reload');r.reload=sample(reload,c,c.width*.08,c.height*.08);compare(r.reload,r.blank);if(l<total)icon('bar_next.svg');console.log('CREATION_PROGRESS simplepaint',l,total);}icon('bar_next.svg');compare(bar.level,1);icon('bar_previous.svg');compare(bar.level,total);evidence.wrap=true;var depth=pageView.depth;icon('bar_help.svg');tryCompare(pageView,'depth',depth+1);evidence.help={title:String(pageView.currentItem.title),content:String(pageView.currentItem.content)};ensure(evidence.help.content.indexOf('Tab')>=0,'PT help includes offered keyboard controls');shot('help');keyClick(Qt.Key_Escape);tryCompare(pageView,'depth',depth);wait(1900);click(cell());shot('finished-grid');ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(pageView,'depth',1);ensure(pageView.currentItem.isMenu,'Menu after completed free drawing');shot('menu');evidence.menu=true;}
 function cleanupTestCase(){console.log('NATIVE_CREATION_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
}
