TestCase {
 name:'WheelColourBindingConfigurationReloadAndGuardedExit'
 when:activity.visible&&canvasArea.width>0
 property var evidence: ({colors:[],savedFiles:[]})
 function ensure(ok,msg){if(!ok){grabImage(pageView).save('__QA_OUTPUT__/failure-scene.png');console.log('CREATION_ASSERT',msg);}verify(ok,msg);}
 function all(root,predicate){var out=[];function walk(o){if(!o)return;if(predicate(o))out.push(o);if(o.children)for(var c of o.children)walk(c);}walk(root);return out;}
 function drawn(o){if(!o||!o.visible||o.width<=0||o.height<=0)return false;for(var p=o;p;p=p.parent)if(p.visible===false||p.opacity===0)return false;var q=o.mapToItem(pageView,o.width/2,o.height/2);if(q.x<0||q.y<0||q.x>=pageView.width||q.y>=pageView.height)return false;for(var a=o.parent;a&&a!==pageView;a=a.parent)if(a.clip){var v=o.mapToItem(a,o.width/2,o.height/2);if(v.x<0||v.y<0||v.x>=a.width||v.y>=a.height)return false;}return true;}
 function find(root,p){var a=all(root,function(o){return drawn(o)&&p(o);});ensure(a.length>0,'Visible control exists');return a[0];}
 function click(o){ensure(drawn(o),'Actual click lies in rendered scene');mouseClick(o,o.width/2,o.height/2);wait(180);}
 function icon(name){var o=find(bar,function(o){return o.source!==undefined&&String(o.source).endsWith('/'+name);});click(o);wait(1900);}
 function button(root,text){click(find(root,function(o){return o.text!==undefined&&String(o.text)===text&&o.clicked!==undefined;}));}
 function box(o){var p=o.mapToItem(pageView,0,0);return {x:p.x,y:p.y,width:o.width,height:o.height};}
 function shot(name){var im=grabImage(pageView);im.save('__QA_OUTPUT__/'+name+'.png');return im;}
 function sample(im,o,x,y){var p=o.mapToItem(pageView,x,y);return String(im.pixel(Math.round(p.x),Math.round(p.y)));}
 function drag(o,x,y,dx,dy){mousePress(o,x,y);for(var i=1;i<=12;i++){mouseMove(o,x+dx*i/12,y+dy*i/12,25,Qt.LeftButton);wait(25);}mouseRelease(o,x+dx,y+dy);wait(700);}
 function polygon(o){var points=[[250,200],[500,200],[500,400],[250,400],[250,200]];mousePress(o,points[0][0],points[0][1]);for(var edge=1;edge<points.length;edge++){for(var j=1;j<=8;j++){var a=points[edge-1],b=points[edge];mouseMove(o,a[0]+(b[0]-a[0])*j/8,a[1]+(b[1]-a[1])*j/8,25,Qt.LeftButton);wait(30);}}mouseRelease(o,250,200);wait(700);}

 function typeText(s){for(var c of s){if(c==='Ç')keyClick(Qt.Key_Ccedilla);else if(c==='Ã')keyClick(Qt.Key_Atilde);else if(c==='Á')keyClick(Qt.Key_Aacute);else if(c==='É')keyClick(Qt.Key_Eacute);else{ensure(c.charCodeAt(0)<128,'ASCII key or explicit Qt enum only');keyClick(c);}wait(30);}}
 function saveDrawing(name){keyClick(Qt.Key_S,Qt.ControlModifier);wait(650);evidence.saveDialogVisible=creationHandler.visible;shot('save-request');tryCompare(creationHandler,'visible',true);var field=find(creationHandler,function(o){return o.placeholderText!==undefined&&o.cursorPosition!==undefined;});click(field);typeText(name);evidence.fileNameTyped=String(field.text);shot('save-name');compare(String(field.text),name);var path=String(creationHandler.sharedDirectoryPath)+name+(creationHandler.svgMode?'.svg':'.png');shot('save-dialog');button(creationHandler,'Gravar');wait(500);shot('save-success');button(creationHandler,'OK');tryCompare(creationHandler,'visible',false,5000);wait(800);return path;}
 function openDrawing(name){keyClick(Qt.Key_O,Qt.ControlModifier);tryCompare(creationHandler,'visible',true);wait(800);click(find(creationHandler,function(o){return o.text!==undefined&&o.font!==undefined&&String(o.text)===name;}));shot('open-dialog');button(creationHandler,'Carregar');tryCompare(creationHandler,'visible',false,5000);wait(1000);}
 function confirmYes(){tryCompare(newImageDialog,'active',true);wait(500);button(newImageDialog.item,'Sim');tryCompare(newImageDialog,'active',false,5000);wait(800);}
 function helpAndMenu(){var depth=pageView.depth;icon('bar_help.svg');tryCompare(pageView,'depth',depth+1);evidence.help={title:String(pageView.currentItem.title),content:String(pageView.currentItem.content)};shot('help');keyClick(Qt.Key_Escape);tryCompare(pageView,'depth',depth);wait(1900);ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(pageView,'depth',1);ensure(pageView.currentItem.isMenu,'Stable menu after saved creation');wait(1900);ensure(pageView.currentItem.isMenu);shot('menu');evidence.menu=true;}

 function test_controls(){wait(2500);activity.Window.window.requestActivate();wait(500);ensure(!ApplicationInfo.useSoftwareRenderer);evidence.canvas=box(canvasArea);icon('bar_previous.svg');compare(bar.level,2);icon('bar_next.svg');compare(bar.level,1);evidence.wrap=true;icon('bar_activity_config.svg');tryCompare(dialogActivityConfig,'visible',true);wait(700);var undo=find(dialogActivityConfig,function(o){return o.moved!==undefined&&o.from===1&&o.to===20;});evidence.undoBefore=undo.value;mouseClick(undo,undo.width*.1,undo.height/2);wait(250);evidence.undoSelected=undo.value;shot('config');button(dialogActivityConfig,'Gravar');tryCompare(dialogActivityConfig,'visible',false);wait(1900);icon('bar_activity_config.svg');tryCompare(dialogActivityConfig,'visible',true);wait(700);evidence.undoPersisted=find(dialogActivityConfig,function(o){return o.moved!==undefined&&o.from===1&&o.to===20;}).value;compare(evidence.undoPersisted,evidence.undoSelected);button(dialogActivityConfig,'Cancelar');tryCompare(dialogActivityConfig,'visible',false);wait(1900);
  for(var index=0;index<2;index++){click(colorButton);wait(400);var palette=find(colorPanel,function(o){return o.paletteSelected!==undefined&&o.currentIndex!==undefined;});if(index===1)click(find(palette,function(o){return o.source!==undefined&&String(o.source).endsWith('/arrow.svg')&&o.mirror===true;}));compare(palette.currentIndex,index);var swatches=all(colorPanel,function(o){return drawn(o)&&o.buttonColor!==undefined;});compare(swatches.length,9);var chosen=index===0?1:4;click(swatches[chosen]);var colour=String(swatches[chosen].buttonColor);evidence.colors.push({palette:index,color:colour});shot('colour-'+index);click(colorButton);wait(350);click(playButton);wait(850);click(playButton);wait(850);shot('stroke-'+index);}
  click(hideGears);var path=saveDrawing('CONTROLO');evidence.savedFiles.push(path);evidence.savedFiles.push(path.replace(/\.svg$/,'.png'));shot('saved');icon('bar_reload.svg');shot('reloaded');openDrawing('CONTROLO.svg');shot('opened');evidence.reopened=true;click(playButton);wait(700);click(playButton);wait(850);shot('before-partial-exit');ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(newImageDialog,'active',true);wait(600);shot('partial-exit-question');button(newImageDialog.item,'Não');tryCompare(newImageDialog,'active',false);wait(900);shot('partial-exit-preserved');evidence.partialExitCancelled=true;path=saveDrawing('CONTROLO2');evidence.savedFiles.push(path);evidence.savedFiles.push(path.replace(/\.svg$/,'.png'));
  click(fileButton);wait(350);button(filePanel,'Cor do fundo');tryCompare(backgroundColorSelector,'visible',true);wait(600);click(find(backgroundColorSelector,function(o){return o.buttonColor!==undefined&&String(o.buttonColor)==='#75d11c';}));click(find(backgroundColorSelector,function(o){return o.source!==undefined&&String(o.source).endsWith('/cancel.svg');}));wait(700);if(filePanel.visible)mouseClick(activityBackground,activityBackground.width*.1,activityBackground.height*.7);wait(300);click(fileButton);wait(350);button(filePanel,'Criar uma nova imagem');wait(800);if(newImageDialog.active)confirmYes();shot('green-background');evidence.background='#75d11c';path=saveDrawing('FUNDO');evidence.savedFiles.push(path);evidence.savedFiles.push(path.replace(/\.svg$/,'.png'));helpAndMenu();}
 function cleanupTestCase(){console.log('NATIVE_CREATION_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
}
