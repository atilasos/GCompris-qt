TestCase {
 name:'SketchPalettesSettingsBackgroundsPersistenceAndPartialExit'
 when:activity.visible&&canvasArea.width>0
 property var evidence: ({palettes:[],settings:[],patterns:[],backgrounds:{}})
 function ensure(ok,msg){if(!ok){grabImage(pageView).save('__QA_OUTPUT__/failure-scene.png');console.log('CREATION_ASSERT',msg);}verify(ok,msg);}
 function all(root,predicate){var out=[];function walk(o){if(!o)return;if(predicate(o))out.push(o);if(o.children)for(var c of o.children)walk(c);}walk(root);return out;}
 function drawn(o){if(!o||!o.visible||o.width<=0||o.height<=0)return false;for(var p=o;p;p=p.parent)if(p.visible===false||p.opacity===0)return false;var q=o.mapToItem(pageView,o.width/2,o.height/2);if(q.x<0||q.y<0||q.x>=pageView.width||q.y>=pageView.height)return false;for(var a=o.parent;a&&a!==pageView;a=a.parent)if(a.clip){var v=o.mapToItem(a,o.width/2,o.height/2);if(v.x<0||v.y<0||v.x>=a.width||v.y>=a.height)return false;}return true;}
 function find(root,p){var a=all(root,function(o){return drawn(o)&&p(o);});ensure(a.length>0,'Visible control exists');return a[0];}
 function click(o){ensure(drawn(o),'Actual click lies in rendered scene');mouseClick(o,o.width/2,o.height/2);wait(180);}
 function icon(name){var o=find(bar,function(o){return o.source!==undefined&&String(o.source).endsWith('/'+name);});click(o);wait(1900);}
 function button(root,text){click(find(root,function(o){return o.text!==undefined&&String(o.text)===text&&o.clicked!==undefined;}));}
 function box(o){var p=o.mapToItem(pageView,0,0);return {x:p.x,y:p.y,width:o.width,height:o.height};}
 function shot(name){var im=grabImage(pageView);im.save('__QA_OUTPUT__/'+name+'.png');return im;}
 function sample(im,o,x,y){var p=o.mapToItem(pageView,x,y);return String(im.pixel(Math.round(p.x),Math.round(p.y)));}
 function drag(o,x,y,dx,dy){mousePress(o,x,y);for(var i=1;i<=12;i++){mouseMove(o,x+dx*i/12,y+dy*i/12,25,Qt.LeftButton);wait(25);}mouseRelease(o,x+dx,y+dy);wait(700);}
 function polygon(o){var points=[[250,200],[500,200],[500,400],[250,400],[250,200]];mousePress(o,points[0][0],points[0][1]);for(var edge=1;edge<points.length;edge++){for(var j=1;j<=8;j++){var a=points[edge-1],b=points[edge];mouseMove(o,a[0]+(b[0]-a[0])*j/8,a[1]+(b[1]-a[1])*j/8,25,Qt.LeftButton);wait(30);}}mouseRelease(o,250,200);wait(700);}

 function typeText(s){for(var c of s){if(c==='Ç')keyClick(Qt.Key_Ccedilla);else if(c==='Ã')keyClick(Qt.Key_Atilde);else if(c==='Á')keyClick(Qt.Key_Aacute);else if(c==='É')keyClick(Qt.Key_Eacute);else{ensure(c.charCodeAt(0)<128,'ASCII key or explicit Qt enum only');keyClick(c);}wait(30);}}
 function saveDrawing(name){keyClick(Qt.Key_S,Qt.ControlModifier);wait(650);evidence.saveDialogVisible=creationHandler.visible;shot('save-request');tryCompare(creationHandler,'visible',true);var field=find(creationHandler,function(o){return o.placeholderText!==undefined&&o.cursorPosition!==undefined;});click(field);typeText(name);evidence.fileNameTyped=String(field.text);shot('save-name');compare(String(field.text),name);var path=String(creationHandler.sharedDirectoryPath)+name+(creationHandler.svgMode?'.svg':'.png');shot('save-dialog');button(creationHandler,'Gravar');wait(500);shot('save-success');button(creationHandler,'OK');tryCompare(creationHandler,'visible',false,5000);wait(800);return path;}
 function openDrawing(name){keyClick(Qt.Key_O,Qt.ControlModifier);tryCompare(creationHandler,'visible',true);wait(800);click(find(creationHandler,function(o){return o.text!==undefined&&o.font!==undefined&&String(o.text)===name;}));shot('open-dialog');button(creationHandler,'Carregar');tryCompare(creationHandler,'visible',false,5000);wait(1000);}
 function confirmYes(){tryCompare(newImageDialog,'active',true);wait(500);button(newImageDialog.item,'Sim');tryCompare(newImageDialog,'active',false,5000);wait(800);}
 function helpAndMenu(){var depth=pageView.depth;icon('bar_help.svg');tryCompare(pageView,'depth',depth+1);evidence.help={title:String(pageView.currentItem.title),content:String(pageView.currentItem.content)};shot('help');keyClick(Qt.Key_Escape);tryCompare(pageView,'depth',depth);wait(1900);ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(pageView,'depth',1);ensure(pageView.currentItem.isMenu,'Stable menu after saved creation');wait(1900);ensure(pageView.currentItem.isMenu);shot('menu');evidence.menu=true;}

 function toggle(panel,open){if(panel.isOpen!==open){click(panel.icon2);wait(400);}compare(panel.isOpen,open);}
 function choose(name){click(find(toolsPanel,function(o){return o.buttonClicked!==undefined&&o.iconSource!==undefined&&String(o.iconSource).endsWith('/'+name+'.svg');}));wait(180);}
 function snap(name){mouseMove(activityBackground,1,activityBackground.height-1);wait(180);return shot(name);}
 function test_controls(){wait(2500);activity.Window.window.requestActivate();wait(500);ensure(!ApplicationInfo.useSoftwareRenderer);var baseDepth=pageView.depth;evidence.canvas=box(canvasArea);for(var index=0;index<12;index++){toggle(colorsPanel,true);var palette=find(colorsPanel,function(o){return o.paletteSelected!==undefined&&o.currentIndex!==undefined;});compare(palette.currentIndex,index);var swatches=all(colorsPanel,function(o){return drawn(o)&&o.buttonColor!==undefined;});compare(swatches.length,9);var image=shot('palette-'+index);var record={index:index,colors:swatches.map(function(o){return {color:String(o.buttonColor),geometry:box(o),pixel:sample(image,o,o.width/2,o.height/2)};})};evidence.palettes.push(record);click(swatches[4]);toggle(colorsPanel,false);drag(canvasArea,80,40+index*25,160,0);snap('palette-'+index+'-stroke');toggle(colorsPanel,true);click(find(palette,function(o){return o.source!==undefined&&String(o.source).endsWith('/arrow.svg')&&o.mirror===true;}));if(index===11)compare(palette.currentIndex,11);toggle(colorsPanel,false);console.log('CREATION_PROGRESS sketch-palette',index+1,12);}snap('before-color-edit');toggle(colorsPanel,true);evidence.hsv=all(colorsPanel,function(o){return drawn(o)&&o.title!==undefined&&o.gradient!==undefined&&o.valueChanged!==undefined;}).map(function(o){var before=String(colorsPanel.selectedColor);mouseClick(o,o.width*.6,o.height*.75);wait(200);return {title:String(o.title),before:before,after:String(colorsPanel.selectedColor),geometry:box(o)};});shot('hsv');toggle(colorsPanel,false);snap('after-color-edit');
  for(var selection of [['brushTools','circlesBrush'],['geometryTools','rectangleTool'],['gradientTools','linearGradient'],['stampTools',''],['textTools',''],['eraserTools','sprayBrush']]){toggle(toolsPanel,true);choose(selection[0]);if(selection[1])choose(selection[1]);var settings=all(toolsPanel,function(o){return drawn(o)&&o.sliderMoved!==undefined&&o.labelText!==undefined;});for(var setting of settings){var slider=find(setting,function(o){return o.moved!==undefined&&o.from!==undefined;}),before=slider.value;mouseClick(slider,slider.width*.6,slider.height/2);wait(180);evidence.settings.push({group:selection[0],label:String(setting.labelText),from:slider.from,to:slider.to,before:before,after:slider.value});}var mirrors=all(toolsPanel,function(o){return drawn(o)&&o.checked!==undefined&&o.labelText!==undefined;});for(var mirror of mirrors){var value=mirror.checked;click(mirror);evidence.mirror={before:value,after:mirror.checked,label:String(mirror.labelText)};}shot('options-'+selection[0]);toggle(toolsPanel,false);}
  toggle(toolsPanel,true);choose('brushTools');choose('fillBrush');var patterns=find(toolsPanel,function(o){return o.patternClicked!==undefined&&o.value!==undefined;});for(var i=0;i<14;i++){compare(patterns.value,i);evidence.patterns.push({index:i,value:patterns.value});shot('pattern-'+i);click(find(patterns,function(o){return o.source!==undefined&&String(o.source).endsWith('/arrow.svg')&&o.mirror===true;}));}compare(patterns.value,13);toggle(toolsPanel,false);polygon(canvasArea);snap('pattern-drawing');
  ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(newImageDialog,'active',true);wait(400);shot('partial-home-question');button(newImageDialog.item,'Não');tryCompare(newImageDialog,'active',false);wait(800);snap('partial-home-preserved');evidence.partialHomeCancelled=true;keyClick(Qt.Key_N,Qt.ControlModifier);tryCompare(newImageDialog,'active',true);wait(400);button(newImageDialog.item,'Não');tryCompare(newImageDialog,'active',false);wait(800);snap('new-cancel-preserved');evidence.newCancelled=true;evidence.savedFiles=[saveDrawing('CORES')];snap('saved-palette-work');
  icon('bar_activity_config.svg');tryCompare(dialogActivityConfig,'visible',true);wait(700);var undo=find(dialogActivityConfig,function(o){return o.moved!==undefined&&o.from===1&&o.to===20;});var before=undo.value;mouseClick(undo,undo.width*.1,undo.height/2);wait(250);evidence.undoConfig={before:before,selected:undo.value};shot('config');button(dialogActivityConfig,'Gravar');tryCompare(dialogActivityConfig,'visible',false);wait(1900);icon('bar_activity_config.svg');tryCompare(dialogActivityConfig,'visible',true);wait(700);evidence.undoConfig.persisted=find(dialogActivityConfig,function(o){return o.moved!==undefined&&o.from===1&&o.to===20;}).value;compare(evidence.undoConfig.persisted,evidence.undoConfig.selected);button(dialogActivityConfig,'Cancelar');tryCompare(dialogActivityConfig,'visible',false);wait(1900);snap('after-config');drag(canvasArea,90,120,160,50);snap('background-current-drawing');
  toggle(filesPanel,true);button(filesPanel,'Imagem de fundo');tryCompare(backgroundSelector,'visible',true);wait(500);var view=find(backgroundSelector,function(o){return o.cellWidth!==undefined&&o.count!==undefined&&o.contentY!==undefined;});evidence.backgroundCount=view.count;for(var page=0;page<15;page++){for(var k=0;k<view.count;k++){var tile=view.itemAtIndex(k);if(tile&&drawn(tile)){var image=find(tile,function(o){return o.source!==undefined&&o.status!==undefined;});compare(image.status,Image.Ready);evidence.backgrounds[k]={source:String(image.source),width:image.implicitWidth,height:image.implicitHeight,geometry:box(tile)};}}shot('background-page-'+page);if(Object.keys(evidence.backgrounds).length===view.count)break;mouseWheel(view,view.width/2,view.height/2,0,-600);wait(450);}compare(Object.keys(evidence.backgrounds).length,view.count);for(var scroll=0;scroll<15&&!view.atYBeginning;scroll++){mouseWheel(view,view.width/2,view.height/2,0,600);wait(200);}click(view.itemAtIndex(1));tryCompare(pageView,'depth',baseDepth);wait(700);wait(800);if(filesPanel.isOpen)toggle(filesPanel,false);snap('background-selected-preserved');keyClick(Qt.Key_N,Qt.ControlModifier);wait(400);if(newImageDialog.active)confirmYes();wait(600);snap('photo-background');
  toggle(filesPanel,true);button(filesPanel,'Imagem de fundo');tryCompare(backgroundSelector,'visible',true);wait(500);view=find(backgroundSelector,function(o){return o.cellWidth!==undefined&&o.count!==undefined&&o.contentY!==undefined;});click(view.itemAtIndex(0));tryCompare(pageView,'depth',baseDepth);wait(700);wait(600);if(filesPanel.isOpen)toggle(filesPanel,false);keyClick(Qt.Key_N,Qt.ControlModifier);wait(400);if(newImageDialog.active)confirmYes();wait(600);snap('no-background');toggle(filesPanel,true);button(filesPanel,'Cor de fundo');tryCompare(backgroundColorSelector,'visible',true);wait(500);var color=find(backgroundColorSelector,function(o){return o.buttonColor!==undefined&&String(o.buttonColor)==='#e87836';});click(color);click(find(backgroundColorSelector,function(o){return o.source!==undefined&&String(o.source).endsWith('/cancel.svg');}));wait(700);if(filesPanel.isOpen)toggle(filesPanel,false);keyClick(Qt.Key_N,Qt.ControlModifier);wait(500);if(newImageDialog.active)confirmYes();wait(700);snap('orange-background');evidence.backgroundColor='#e87836';evidence.savedFiles.push(saveDrawing('FUNDO'));helpAndMenu();}
 function cleanupTestCase(){console.log('NATIVE_CREATION_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
