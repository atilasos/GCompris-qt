TestCase {
 name:'BothWheelLevelsNaturalGeometryStopResumeAndPhysicalFiles'
 when:activity.visible&&canvasArea.width>0
 property var evidence: ({levels:[],savedFiles:[]})
__VISIBLE__
__FILES__
 function numberLabel(o){return String(find(o,function(c){return c.text!==undefined&&c.font!==undefined&&/^\d+$/.test(String(c.text));}).text);}
 function choices(kind){return all(wheelPanel,function(o){return drawn(o)&&o.clicked!==undefined&&o.source!==undefined&&String(o.source).endsWith('/'+kind+'.svg');});}
 function geometry(){var c=canvasArea.mapFromItem(theWheel,theWheel.width/2,theWheel.height/2),g=canvasArea.mapFromItem(theGear,theGear.width/2,theGear.height/2),p=canvasArea.mapFromItem(pencil,pencil.width/2,pencil.height/2);return {center:{x:c.x,y:c.y},gear:{x:g.x,y:g.y,rotation:theGear.rotation,width:theGear.width,height:theGear.height},pen:{x:p.x,y:p.y},canvas:box(canvasArea)};}
 function slide(o,fraction){var before=o.value;mouseClick(o,o.width*fraction,o.height/2);wait(350);return {from:o.from,to:o.to,before:before,value:o.value,step:o.stepSize,geometry:box(o)};}
 function test_levels(){wait(2500);activity.Window.window.requestActivate();wait(500);ensure(!ApplicationInfo.useSoftwareRenderer);evidence.publicLevels=activity.numberOfLevel;compare(evidence.publicLevels,2);for(var level=1;level<=2;level++){compare(bar.level,level);var record={level:level};evidence.levels.push(record);click(gearButton);wait(350);shot('level-'+level+'-wheel-options');if(level===1){record.fixed=[];var buttons=choices('wheel');compare(buttons.length,7);var wheels=buttons.map(function(b){return numberLabel(b);});for(var label of wheels){click(choices('wheel').filter(function(b){return numberLabel(b)===label;})[0]);var gears=choices('gear').map(function(b){return numberLabel(b);});var selected={wheel:label,gears:gears};record.fixed.push(selected);for(var gear of gears){click(choices('gear').filter(function(b){return numberLabel(b)===gear;})[0]);compare(numberLabel(gearButton),gear);}shot('wheel-'+label+'-gear-options');}click(choices('wheel').filter(function(b){return numberLabel(b)==='96';})[0]);click(choices('gear').filter(function(b){return numberLabel(b)==='30';})[0]);}else{record.wheelSlider=slide(wheelTeethSlider,.45);record.gearSlider=slide(gearTeethSlider,.35);}record.wheel=Number(wheelTeethSlider.value);record.gear=Number(gearTeethSlider.value);record.speed=slide(timerValue,.6);shot('level-'+level+'-chosen-options');click(gearButton);wait(350);click(pencilButton);wait(350);record.penSize=slide(penSizeSlider,.2);record.penOpacity=slide(penOpacitySlider,.7);record.penOffset=slide(penOffsetSlider,.5);record.toothOffset=slide(toothOffsetSlider,.6);shot('level-'+level+'-pen-options');click(pencilButton);wait(350);record.initial=geometry();shot('level-'+level+'-initial');click(playButton);ensure(String(playButton.source).endsWith('/stop.svg'),'Real play starts drawing');wait(700);record.moving=geometry();ensure(Math.abs(record.moving.pen.x-record.initial.pen.x)+Math.abs(record.moving.pen.y-record.initial.pen.y)>2,'Pen moves by normal timer');click(playButton);ensure(String(playButton.source).endsWith('/play.svg'),'Real stop stops drawing');wait(700);record.stopped=geometry();wait(700);record.still=geometry();compare(JSON.stringify(record.stopped),JSON.stringify(record.still));shot('level-'+level+'-stopped');click(playButton);tryVerify(function(){return String(playButton.source).endsWith('/play.svg');},90000);wait(900);record.completed=geometry();shot('level-'+level+'-completed');keyClick(Qt.Key_Z,Qt.ControlModifier);wait(800);shot('level-'+level+'-undo');keyClick(Qt.Key_Y,Qt.ControlModifier);wait(800);shot('level-'+level+'-redo');click(hideGears);shot('level-'+level+'-without-gears');record.savedPath=saveDrawing('RODAS'+level);evidence.savedFiles.push(record.savedPath);evidence.savedFiles.push(record.savedPath.replace(/\.svg$/,'.png'));shot('level-'+level+'-saved');click(fileButton);wait(350);button(filePanel,'Criar uma imagem nova');wait(800);if(newImageDialog.active)confirmYes();shot('level-'+level+'-new');openDrawing('RODAS'+level+'.svg');shot('level-'+level+'-opened');grabImage(canvasArea).save('__QA_OUTPUT__/level-'+level+'-widget-opened.png');record.reopened=geometry();if(level<2){icon('bar_next.svg');if(newImageDialog.active)confirmYes();wait(500);}console.log('CREATION_PROGRESS drawing_wheels',level,2);}helpAndMenu();}
 function cleanupTestCase(){console.log('NATIVE_CREATION_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
