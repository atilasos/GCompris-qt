// Seam: the real menu and activity controls, never the rule engine or game state.
TestCase {
    name: "DominorioNative"
    when: activity.visible
    function textIn(item, text) {
        if (item.text !== undefined && String(item.text).indexOf(text) >= 0) return true;
        for (var i = 0; i < item.children.length; ++i)
            if (textIn(item.children[i], text)) return true;
        return false;
    }
    function icon(item, suffix) {
        if (item.source !== undefined && String(item.source).endsWith(suffix)) return item;
        for (var i = 0; i < item.children.length; ++i) {
            var found = icon(item.children[i], suffix); if (found) return found;
        }
        return null;
    }
    function ensure(value, message) { if (!value) console.log("DOMINORIO_ASSERT_FAILED", message || "", new Error().stack); verify(value, message || ""); }
    function click(item) { ensure(item !== null); mouseClick(item, item.width / 2, item.height / 2); wait(60); }
    function test_menu_to_complete_game() {
        wait(1500);
        var search = section.itemAtIndex(section.count - 1);
        click(search);
        mouseClick(searchTextField, searchTextField.width / 2, searchTextField.height / 2);
        keyClick(Qt.Key_D); keyClick(Qt.Key_O); keyClick(Qt.Key_M); keyClick(Qt.Key_I); keyClick(Qt.Key_N);
        wait(800);
        var card = null;
        for (var d = 0; d < activitiesGrid.count; ++d) {
            var candidate = activitiesGrid.itemAtIndex(d);
            if (candidate && textIn(candidate, "Dominório")) card = candidate;
        }
        ensure(card !== null, "Search finds native activity");
        click(card);
        tryVerify(function() { return activityLoader.item && activityLoader.item.visible; }, 5000);
        wait(800);
        var game = activityLoader.item;
        var board = findChild(game, "dominorioBoard");
        ensure(board !== null, "Native board loaded");
        var confirm = findChild(game, "confirmDomino");
        var restart = findChild(game, "restartDomino");
        ensure(textIn(game, "Participante 1 · Vertical"));
        ensure(!confirm.enabled);
        // First CRJM reference move: (row 0, column 0), vertical. Preview does not place.
        board.forceActiveFocus();
        keyClick(Qt.Key_Space);
        ensure(confirm.enabled);
        ensure(textIn(game, "Confirma para colocar"));
        grabImage(pageView).save("__QA_OUTPUT__/preview.png");
        keyClick(Qt.Key_Return);
        ensure(textIn(game, "Participante 2 · Horizontal"));
        ensure(textIn(findChild(game, "dominoCell0"), "1 ↕"));
        ensure(textIn(findChild(game, "dominoCell8"), "1 ↕"));
        // Occupied cell and right-edge wrap must leave turn and board intact.
        click(findChild(game, "dominoCell0"));
        ensure(!confirm.enabled); ensure(textIn(game, "Jogada impossível"));
        click(findChild(game, "dominoCell7"));
        ensure(!confirm.enabled); ensure(textIn(game, "Participante 2 · Horizontal"));
        // Help must preserve both pieces and the current player.
        click(icon(game, "bar_help.svg"));
        tryCompare(pageView, "depth", 3, 2000);
        ensure(pageView.currentItem.content.indexOf("duas casas vazias") >= 0);
        grabImage(pageView).save("__QA_OUTPUT__/help.png");
        keyClick(Qt.Key_Escape);
        tryCompare(pageView, "depth", 2, 2000); wait(500);
        ensure(textIn(findChild(game, "dominoCell8"), "1 ↕"));
        ensure(textIn(game, "Participante 2 · Horizontal"));
        // Complete legal transcript generated by CRJM reference b206a7b4,
        // using its first legal move each turn. Expected winner is player 2.
        var moves = [1,3,4,6,9,7,12,16,17,19,20,22,25,23,28,32,33,35,36,38,41,39,44,48,49,51,52,54,57,55,60];
        for (var n = 0; n < moves.length; ++n) {
            var cell = findChild(game, "dominoCell" + moves[n]);
            if (n === 0) {
                touchEvent(cell).press(0, cell, cell.width / 2, cell.height / 2).commit();
                touchEvent(cell).release(0, cell, cell.width / 2, cell.height / 2).commit();
                wait(80);
            } else click(cell);
            ensure(confirm.enabled, "Legal reference move " + n);
            click(confirm);
        }
        ensure(textIn(game, "Venceu o participante 2!"));
        ensure(textIn(game, "O participante 1 ficou sem uma jogada válida."));
        ensure(!confirm.enabled);
        grabImage(pageView).save("__QA_OUTPUT__/result.png");
        click(restart);
        ensure(textIn(game, "Participante 1 · Vertical"));
        ensure(!textIn(findChild(game, "dominoCell0"), "1 ↕"));
        ensure(!confirm.enabled);
        // Arrow navigation and keyboard preview/confirmation after restart.
        keyClick(Qt.Key_Tab); keyClick(Qt.Key_Tab, Qt.ShiftModifier);
        keyClick(Qt.Key_Right); keyClick(Qt.Key_Space); keyClick(Qt.Key_Return);
        ensure(textIn(findChild(game, "dominoCell1"), "1 ↕"));
        var window = game.Window.window;
        window.width = 1100; window.height = 700;
        wait(350);
        ensure(board.width / 8 >= 40, "Desktop cells remain selectable");
        grabImage(pageView).save("__QA_OUTPUT__/desktop.png");
        window.width = 600; window.height = 900;
        wait(350);
        ensure(board.width / 8 >= 40, "Portrait cells remain selectable");
        ensure(confirm.mapToItem(game, 0, 0).y + confirm.height <= game.height, "Portrait controls fit");
        grabImage(pageView).save("__QA_OUTPUT__/portrait.png");
        click(icon(game, "bar_home.svg"));
        tryCompare(pageView, "depth", 1, 2000);
        ensure(pageView.currentItem.isMenu);
        grabImage(pageView).save("__QA_OUTPUT__/menu.png");
    }
    function cleanupTestCase() {
        if (qtest_results.failCount) grabImage(pageView).save("__QA_OUTPUT__/failure.png");
        console.log("NATIVE_RESULT", JSON.stringify({failures:qtest_results.failCount, passes:qtest_results.passCount}));
    }
}
