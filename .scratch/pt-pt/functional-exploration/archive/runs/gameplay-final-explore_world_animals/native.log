qml: NATIVE_RESULT {"failures":0,"passes":2,"pages":[{"map":1,"title":"Jaguar","description":"A mandíbula do jaguar está bem desenvolvida. Por causa disso, tem a mordedura mais forte de todos os felinos, sendo capaz de quebrar até uma carapaça de tartaruga!","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/jaguar.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.363125,"y":0.556875,"audio":"qrc:/gcompris/data/voices-ogg/pt/intro/explore_world_animals.ogg"},{"map":1,"title":"Ouriço","description":"Os ouriços comem pequenos animais, como os sapos e os insetos, pelo que muitas pessoas os usam como animais de estimação úteis. Em caso de perigo, enrolam-se como uma bola e espetam os seus espinhos afiados.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/hedgehog.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.500625,"y":0.424375,"audio":"qrc:/gcompris/data/voices-ogg/pt/intro/explore_world_animals.ogg"},{"map":1,"title":"Girafa","description":"A girafa vive em África e é o mamífero mais alto do mundo. Só as suas pernas, que têm normalmente 1,80 metros de comprimento, são maiores que a maioria dos humanos!","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/giraffe.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.519375,"y":0.523125,"audio":"qrc:/gcompris/data/voices-ogg/pt/intro/explore_world_animals.ogg"},{"map":1,"title":"Bisonte","description":"Os bisontes vivem nas planícies da América do Norte e eram caçados pelos povos indígenas para alimentação. No entanto, a sua quase extinção deve-se ao massacre pelos colonizadores, por desporto e para desocupar terras, e não à caça praticada pelos povos indígenas.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/bison.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.284375,"y":0.458125,"audio":"qrc:/gcompris/data/voices-ogg/pt/intro/explore_world_animals.ogg"},{"map":1,"title":"Narval","description":"Os narvais são baleias que vivem no oceano Ártico e têm uma longa presa. Esta presa faz lembrar o corno do mítico unicórnio.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/narwhal.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.476875,"y":0.314375,"audio":"qrc:/gcompris/data/voices-ogg/pt/intro/explore_world_animals.ogg"},{"map":2,"title":"Camaleão","description":"O Camaleão vive na África e Madagáscar e é conhecido pela sua capacidade de mudar a cor da sua pele numa questão de segundos.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/chameleon.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.575625,"y":0.586875,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/fantastic.ogg"},{"map":2,"title":"Urso polar","description":"O Urso Polar é um dos maiores mamíferos predadores do mundo. Pesa cerca de uma tonelada e consegue atingir os 3 metros de comprimento!","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/polar_bear.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.398125,"y":0.310625,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/fantastic.ogg"},{"map":2,"title":"Canguru","description":"O Canguru vive na Austrália e é conhecido pela bolsa na sua barriga, usada para trazer os cangurus-bebés.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/kangaroo.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.758125,"y":0.598125,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/fantastic.ogg"},{"map":2,"title":"Arara vermelha","description":"A arara vermelha vive na América do Sul e é um papagaio grande e brilhante, sendo capaz de aprender até 100 palavras!","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/scarlet_macaw.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.348125,"y":0.538125,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/fantastic.ogg"},{"map":2,"title":"Alce","description":"O alce é o maior dos veados e come até 25 kg por dia. Por vezes, ergue-se sobre as patas traseiras para alcançar ramos a uma altura de até 4 metros!","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/moose.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.215625,"y":0.401875,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/fantastic.ogg"},{"map":3,"title":"Crocodilo","description":"Um crocodilo é um enorme réptil anfíbio. Vive principalmente nos grandes rios tropicais, onde atua como predador por emboscada.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/crocodile.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.519375,"y":0.538125,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/super.ogg"},{"map":3,"title":"Dragão-de-komodo","description":"O dragão-de-komodo é o maior lagarto vivo (até 3 metros). Habita nas ilhas da Indonésia.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/dragon.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.726875,"y":0.560625,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/super.ogg"},{"map":3,"title":"Coala","description":"Os coalas são marsupiais herbívoros que vivem nas florestas de eucaliptos da Austrália Oriental.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/koala.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.791875,"y":0.605625,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/super.ogg"},{"map":3,"title":"Lémure-de-cauda-anelada","description":"O lémure-de-cauda-anelada é um primata que vive nas regiões secas do Sudoeste de Madagáscar. A cauda às riscas torna-o fácil de ser reconhecido.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/lemur.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.571875,"y":0.598125,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/super.ogg"},{"map":3,"title":"Panda","description":"O Panda é um urso com pelo preto e branco que vive em algumas regiões montanhosas da China central. Os pandas comem principalmente bambu.","image":"qrc:/gcompris/src/activities/explore_world_animals/resource/animals/panda.webp","mapImage":"qrc:/gcompris/src/activities/explore_monuments/resource/wonders/world-map.svg","x":0.700625,"y":0.461875,"audio":"qrc:/gcompris/data/voices-ogg/pt/misc/super.ogg"}],"questions":[{"map":1,"stage":2,"kind":"text","prompt":"Jaguar","audio":"","selected":"Jaguar","x":0.363125,"y":0.556875,"before":0,"wrong":{"selected":"Ouriço","unchanged":true},"after":1},{"map":1,"stage":2,"kind":"text","prompt":"Bisonte","audio":"","selected":"Bisonte","x":0.284375,"y":0.458125,"before":1,"after":2},{"map":1,"stage":2,"kind":"text","prompt":"Narval","audio":"","selected":"Narval","x":0.476875,"y":0.314375,"before":2,"after":3},{"map":1,"stage":2,"kind":"text","prompt":"Girafa","audio":"","selected":"Girafa","x":0.519375,"y":0.523125,"before":3,"after":4},{"map":1,"stage":2,"kind":"text","prompt":"Ouriço","audio":"","selected":"Ouriço","x":0.500625,"y":0.424375,"before":4,"after":5},{"map":2,"stage":2,"kind":"text","prompt":"Alce","audio":"","selected":"Alce","x":0.215625,"y":0.401875,"before":0,"wrong":{"selected":"Camaleão","unchanged":true},"after":1},{"map":2,"stage":2,"kind":"text","prompt":"Arara vermelha","audio":"","selected":"Arara vermelha","x":0.348125,"y":0