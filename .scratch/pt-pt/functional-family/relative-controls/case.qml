TestCase {
 name:'FamilyNavigationPartialSelectionHelpFocusAndMenu'
 when:activity.visible&&nodeRepeater.count>0
 property var evidence: ({})
 function find(root,predicate){if(predicate(root))return root;if(root.children)for(var child of root.children){var found=find(child,predicate);if(found)return found;}return null;}
 function drawn(item){var alpha=1;for(var node=item;node&&node!==pageView;node=node.parent){if(!node.visible)return false;if(node.opacity!==undefined)alpha*=node.opacity;}return alpha>0.9&&item.width>0&&item.height>0;}
 function click(item){verify(item!==null);verify(drawn(item));var p=item.mapToItem(pageView,item.width/2,item.height/2);mouseClick(pageView,p.x,p.y,Qt.LeftButton,Qt.NoModifier,0);}
 function icon(suffix){var target=find(bar,function(item){return item.source!==undefined&&String(item.source).endsWith(suffix)&&drawn(item);});verify(target!==null,'Visible icon '+suffix);click(target);wait(1800);}
 function screen(){var people=[],edges=[],rings=[],options=[];for(var i=0;i<nodeRepeater.count;i++){var person=nodeRepeater.itemAt(i);verify(drawn(person));var image=find(person,function(item){return item.source!==undefined&&drawn(item)&&String(item.source).endsWith('.svg');});verify(image!==null);tryCompare(image,'status',1);people.push({x:person.x,y:person.y,width:person.width,height:person.height,source:String(image.source),border:String(person.border.color),color:String(person.color)});}for(var i=0;i<edgeRepeater.count;i++){var edge=edgeRepeater.itemAt(i);verify(drawn(edge));edges.push({x:edge.x,y:edge.y,width:edge.width,height:edge.height,color:String(edge.color)});}for(var i=0;i<ringRepeater.count;i++){var ring=ringRepeater.itemAt(i);verify(drawn(ring));rings.push({x:ring.x,y:ring.y,width:ring.width,height:ring.height,source:String(ring.source)});}for(var i=0;i<answersChoice.count;i++){var button=answersChoice.itemAt(i);if(!drawn(button))continue;var label=find(button,function(item){return item.text!==undefined&&drawn(item)&&String(item.text).length>0;});verify(label!==null);options.push(String(label.text));}return {level:bar.level,publicLevels:activity.numberOfLevel,mode:String(activity.mode),people:people,edges:edges,rings:rings,options:options,question:drawn(instructionPanel)?String(instructionPanel.textItem.text):'',me:drawn(me)?{x:me.x,y:me.y,width:me.width,height:me.height,text:String(meLabel.text)}:null,target:drawn(questionmark)?{x:questionmark.x,y:questionmark.y,width:questionmark.width,height:questionmark.height,text:String(qLabel.text)}:null};}

 function kinGraph(s){var size=s.people[0].width,half=function(value){return Math.round(value/size*2)/2;},people=[],segments=[],rings=[],points={},links={},locations={};var key=function(p){return JSON.stringify(p);};var add=function(p){points[key(p)]=p;};var category={ 'babyBoy.svg':'M','boy1.svg':'M','boy2.svg':'M','man1.svg':'M','man2.svg':'M','man3.svg':'M','oldMan1.svg':'M','babyGirl.svg':'F','girl1.svg':'F','woman1.svg':'F','woman2.svg':'F','oldWoman1.svg':'F'};
  for(var p of s.people){var name=p.source.split('/').pop();verify(category[name]!==undefined,'Audited visible avatar');var person={x:half(p.x+p.width/2),y:half(p.y+p.height/2),sex:category[name]};people.push(person);add([person.x,person.y]);locations[key([person.x,person.y])]=people.length-1;}
  for(var e of s.edges){var line=[half(e.x),half(e.y),half(e.x+e.width),half(e.y+e.height)];verify(line[0]===line[2]||line[1]===line[3]);segments.push(line);add(line.slice(0,2));add(line.slice(2,4));}
  for(var a of segments)for(var b of segments)if(a[1]===a[3]&&b[0]===b[2]&&Math.min(a[0],a[2])<=b[0]&&b[0]<=Math.max(a[0],a[2])&&Math.min(b[1],b[3])<=a[1]&&a[1]<=Math.max(b[1],b[3]))add([b[0],a[1]]);
  var on=function(p,l){return Math.min(l[0],l[2])<=p[0]&&p[0]<=Math.max(l[0],l[2])&&Math.min(l[1],l[3])<=p[1]&&p[1]<=Math.max(l[1],l[3])&&((l[0]===l[2]&&p[0]===l[0])||(l[1]===l[3]&&p[1]===l[1]));};for(var k in points)links[k]=[];
  for(var line of segments){var ordered=Object.keys(points).map(function(k){return points[k];}).filter(function(p){return on(p,line);}).sort(function(a,b){return a[0]-b[0]||a[1]-b[1];});for(var i=1;i<ordered.length;i++){links[key(ordered[i-1])].push(ordered[i]);links[key(ordered[i])].push(ordered[i-1]);}}
  var parents=[],spouses=people.map(function(){return [];});for(var person of people){var start=[person.x,person.y],queue=[start],seen={},found=[];seen[key(start)]=true;while(queue.length){var point=queue.shift();for(var other of links[key(point)]){if(seen[key(other)]||other[1]>point[1]||(point[1]===start[1]&&other[1]===start[1]))continue;seen[key(other)]=true;if(locations[key(other)]!==undefined){if(found.indexOf(locations[key(other)])<0)found.push(locations[key(other)]);}else queue.push(other);}}parents.push(found.sort(function(a,b){return a-b;}));}
  for(var ring of s.rings){var center=[half(ring.x+ring.width/2),half(ring.y+ring.height/2)],left=-1,right=-1;for(var i=0;i<people.length;i++){var p=people[i];if(p.y!==center[1]||!segments.some(function(l){return on(center,l)&&on([p.x,p.y],l);}))continue;if(p.x<center[0]&&(left<0||p.x>people[left].x))left=i;if(p.x>center[0]&&(right<0||p.x<people[right].x))right=i;}verify(left>=0&&right>=0,'Visible ring and couple');spouses[left].push(right);spouses[right].push(left);}
  return {people:people,parents:parents,spouses:spouses};
 }
 function kinRelation(g,me,target){if(me===target)return null;var p=g.parents,s=g.spouses,sex=g.people[target].sex;var word=function(m,f){return sex==='M'?m:f;};var siblings=function(a,b){return a!==b&&p[a].some(function(v){return p[b].indexOf(v)>=0;});};if(p[me].indexOf(target)>=0)return word('Pai','Mãe');if(p[target].indexOf(me)>=0)return word('Filho','Filha');if(p[me].some(function(v){return p[v].indexOf(target)>=0;}))return word('Avô','Avó');if(p[target].some(function(v){return p[v].indexOf(me)>=0;}))return word('Neto','Neta');if(siblings(me,target))return word('Irmão','Irmã');if(p[me].some(function(v){return siblings(v,target);}))return word('Tio','Tia');if(p[target].some(function(v){return siblings(v,me);}))return word('Sobrinho','Sobrinha');if(p[me].some(function(a){return p[target].some(function(b){return siblings(a,b);});}))return word('Primo','Prima');if(s[me].some(function(v){return p[v].indexOf(target)>=0;}))return word('Sogro','Sogra');if(s[target].some(function(v){return p[v].indexOf(me)>=0;}))return word('Genro','Nora');if(s[me].some(function(v){return siblings(v,target);})||s[target].some(function(v){return siblings(v,me);}))return word('Cunhado','Cunhada');return null;}
 function pairChoices(g,word){var result=[];for(var a=0;a<g.people.length;a++)for(var b=a+1;b<g.people.length;b++)if(kinRelation(g,a,b)===word||kinRelation(g,b,a)===word)result.push([a,b]);return result;}
 function familyAnswer(s,g){var me=-1,target=-1;for(var i=0;i<s.people.length;i++){if(s.people[i].border==='#e1e1e1')me=i;if(s.people[i].border==='#e77936')target=i;}verify(me>=0&&target>=0,'Two drawn highlights');return {me:me,target:target,label:kinRelation(g,me,target)};}

 function test_controls(){wait(1900);var initial=screen();evidence.initial=initial;compare(activity.numberOfLevel,18);icon('bar_previous.svg');compare(bar.level,18);evidence.previousWrap=screen();icon('bar_next.svg');compare(bar.level,1);evidence.nextWrap=screen();icon('bar_next.svg');compare(bar.level,2);icon('bar_previous.svg');compare(bar.level,1);evidence.navigation=true;
  for(var suffix of ['bar_reload.svg','bar_activity_config.svg'])verify(find(bar,function(node){return node.source!==undefined&&String(node.source).endsWith(suffix)&&drawn(node);})===null,'No exposed '+suffix);evidence.reloadExposed=false;evidence.configurationExposed=false;
  if(activity.mode==='find_relative'){click(nodeRepeater.itemAt(0));wait(150);compare(String(nodeRepeater.itemAt(0).border.color),'#e77936');evidence.partial=screen();icon('bar_next.svg');compare(bar.level,2);icon('bar_previous.svg');compare(bar.level,1);var reset=screen();verify(reset.people.every(function(person){return person.border==='#373737';}));evidence.partialReset=reset;}
  var depth=pageView.depth;icon('bar_help.svg');tryCompare(pageView,'depth',depth+1);var help=pageView.currentItem;compare(help.title,activity.mode==='family'?'Família':'Indicar os parentes');verify(help.content.indexOf('árvore genealógica')>=0);verify(help.content.indexOf('anel')>=0);verify(help.content.indexOf('A family tree')<0);evidence.help={title:String(help.title),content:String(help.content)};grabImage(pageView).save('__QA_OUTPUT__/help.png');keyClick(Qt.Key_Escape);tryCompare(pageView,'depth',depth);wait(1900);
  var s=screen(),g=kinGraph(s);evidence.afterHelp=s;if(activity.mode==='family'){var answer=familyAnswer(s,g);var selected=s.options.indexOf(answer.label);verify(selected>=0);evidence.selection={index:selected,label:answer.label};click(answersChoice.itemAt(selected));}else{var pairs=pairChoices(g,s.question.split(': ').pop());verify(pairs.length>0);var pair=[pairs[0][1],pairs[0][0]];evidence.selection={pair:pair};click(nodeRepeater.itemAt(pair[0]));wait(180);click(nodeRepeater.itemAt(pair[1]));}tryVerify(function(){return bonus.opacity>0.5&&String(bonus.source).endsWith('/lion_good.svg');},3500);evidence.bonus=String(bonus.source);tryCompare(bonus,'isPlaying',false,9000);compare(bar.level,2);evidence.focusAfterHelp=true;
  ActivityInfoTree.startingActivity='';icon('bar_home.svg');tryCompare(pageView,'depth',1);verify(pageView.currentItem.isMenu);evidence.menu=true;grabImage(pageView).save('__QA_OUTPUT__/menu.png');
 }
 function cleanupTestCase(){console.log('NATIVE_FAMILY_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
