 function find(root,predicate){if(predicate(root))return root;if(root.children)for(var child of root.children){var value=find(child,predicate);if(value)return value;}return null;}
 function collect(root,predicate){var result=[];if(predicate(root))result.push(root);if(root.children)for(var child of root.children)result=result.concat(collect(child,predicate));return result;}
 function drawn(item){var alpha=1;for(var p=item;p&&p!==pageView;p=p.parent){if(!p.visible)return false;if(p.opacity!==undefined)alpha*=p.opacity;}return alpha>0.9&&item.width>0&&item.height>0;}
 function click(item){ensure(item!==null);ensure(drawn(item));var p=item.mapToItem(pageView,item.width/2,item.height/2);ensure(p.x>=0&&p.x<pageView.width&&p.y>=0&&p.y<pageView.height,'Clickable inside viewport');mouseClick(pageView,p.x,p.y,Qt.LeftButton,Qt.NoModifier,0);}
 function icon(suffix){wait(1800);var item=find(bar,function(node){return node.source!==undefined&&String(node.source).endsWith(suffix)&&drawn(node);});ensure(item!==null,'Visible icon '+suffix);click(item);wait(1800);}
 function labels(root){return collect(root,function(item){return item.font!==undefined&&item.text!==undefined&&drawn(item)&&String(item.text)!=='';}).map(function(item){return String(item.text);});}
 function configBoxes(){return collect(dialogActivityConfig,function(item){return item.checked!==undefined&&item.indicatorImageHeight!==undefined&&item.text!==undefined&&drawn(item);});}
 function openConfig(){if(!dialogActivityConfig.visible)icon('bar_activity_config.svg');tryCompare(dialogActivityConfig,'visible',true);wait(900);}
 function chooseDataset(index){openConfig();var boxes=configBoxes();ensure(index>=0&&index<boxes.length,'Offered dataset');var target=boxes[index];if(!target.checked)click(target);for(var item of boxes)if(item!==target&&item.checked)click(item);ensure(target.checked);ensure(boxes.filter(function(item){return item.checked;}).length===1);var selected=boxes.map(function(item){return {label:String(item.text),checked:item.checked};});var save=find(dialogActivityConfig,function(item){return item.text==='Gravar'&&item.clicked!==undefined&&drawn(item);});ensure(save!==null);click(save);tryCompare(dialogActivityConfig,'visible',false);wait(1900);return selected;}
 function gridRepeater(){var value=find(boardItem,function(item){return item.itemAt!==undefined&&item.count!==undefined;});ensure(value!==null);return value;}
 function imageSource(item){var image=find(item,function(node){return node.source!==undefined&&drawn(node)&&String(node.source).endsWith('.svg');});if(image){tryCompare(image,'status',1,2500);return String(image.source);}return '';}
 function screen(){var rep=gridRepeater(),cells=[],palette=[],regions=[],cages=[],size=0;for(var i=0;i<rep.count;i++){var cell=rep.itemAt(i);ensure(drawn(cell));var p=cell.mapToItem(boardItem,0,0);cells.push({x:p.x,y:p.y,width:cell.width,height:cell.height,source:imageSource(cell),color:String(cell.color),labels:labels(cell)});size=Math.max(size,Math.round(p.x/cell.width)+1);}for(var i=0;i<availablePieces.view.count;i++){var piece=availablePieces.view.itemAtIndex(i);ensure(piece!==null);ensure(drawn(piece));palette.push({source:imageSource(piece),x:piece.x,y:piece.y,width:piece.width,height:piece.height});}if(!arithmetic&&regionGrid.visible){for(var i=0;i<regionRepeater.count;i++){var box=regionRepeater.itemAt(i);if(drawn(box))regions.push({x:box.x,y:box.y,width:box.width,height:box.height});}}if(arithmetic){var repC=find(calcudokuCages,function(item){return item.itemAt!==undefined&&item.count!==undefined;});ensure(repC!==null);for(var i=0;i<repC.count;i++){var cage=repC.itemAt(i),walls=[];for(var wall of cage.children)if(drawn(wall)&&wall.color!==undefined){walls.push({x:wall.x,y:wall.y,width:wall.width,height:wall.height,color:String(wall.color)});}cages.push({x:cage.x,y:cage.y,width:cage.width,height:cage.height,walls:walls});}}var scoreText=labels(score);return {level:bar.level,publicLevels:activity.numberOfLevel,cells:cells,size:size,palette:palette,regions:regions,cages:cages,score:scoreText};}

 function cageOK(values,target,op){if(values.length===1)return op===''&&values[0]===target;if(op==='+')return values.reduce(function(a,b){return a+b;},0)===target;if(op==='×'||op==='*')return values.reduce(function(a,b){return a*b;},1)===target;if(values.length!==2)throw new Error('Only +/× allowed for larger cages');if(op==='−'||op==='-')return Math.abs(values[0]-values[1])===target;if(['∕','÷',':','/'].indexOf(op)>=0){var a=Math.min(values[0],values[1]),b=Math.max(values[0],values[1]);return b%a===0&&b/a===target;}throw new Error('Unknown cage operator');}
 function visiblePuzzle(screen,arithmetic){var n=screen.size,cells=new Array(n*n),symbols=screen.palette.map(function(p){return p.source;});if(symbols.length!==n||new Set(symbols).size!==n||symbols.indexOf('')>=0)throw new Error('Visible palette incomplete');for(var cell of screen.cells){var c=Math.round(cell.x/cell.width),r=Math.round(cell.y/cell.height),i=r*n+c;if(c<0||c>=n||r<0||r>=n||cells[i]!==undefined)throw new Error('Ambiguous cell geometry');cells[i]=cell;}var givens=cells.map(function(cell){if(!cell.source)return 0;var index=symbols.indexOf(cell.source);if(index<0)throw new Error('Clue absent from palette');return arithmetic?Number(cell.source.split('/').pop().replace('.svg','')):index+1;});var p={n:n,givens:givens,regions:[],cages:[]};if(!arithmetic){for(var box of screen.regions){var region=[];for(var i=0;i<cells.length;i++){var cell=cells[i],x=cell.x+cell.width/2,y=cell.y+cell.height/2;if(box.x<=x&&x<box.x+box.width&&box.y<=y&&y<box.y+box.height)region.push(i);}if(region.length!==n)throw new Error('Visible region size');p.regions.push(region);}}else{var walls={},frames={};for(var frame of screen.cages){var i=Math.round(frame.y/frame.height)*n+Math.round(frame.x/frame.width),edges=[];for(var wall of frame.walls)edges.push(wall.width>wall.height?(wall.y+wall.height/2<frame.height/2?'T':'B'):(wall.x+wall.width/2<frame.width/2?'L':'R'));walls[i]=edges;frames[i]=frame;}if(Object.keys(frames).length!==n*n)throw new Error('Cage frames missing');var seen={};for(var start=0;start<n*n;start++){if(seen[start])continue;seen[start]=true;var queue=[start],group=[];while(queue.length){var cell=queue.pop(),row=Math.floor(cell/n),col=cell%n;group.push(cell);for(var step of [[cell-1,col>0,'L','R'],[cell+1,col<n-1,'R','L'],[cell-n,row>0,'T','B'],[cell+n,row<n-1,'B','T']])if(step[1]&&!seen[step[0]]&&walls[cell].indexOf(step[2])<0&&walls[step[0]].indexOf(step[3])<0){seen[step[0]]=true;queue.push(step[0]);}}var labels=[];for(var cell of group)labels=labels.concat(cells[cell].labels);if(labels.length!==1)throw new Error('Cage requires one drawn label');var match=/^(\d+)([+−×∕÷:*\/-]?)$/.exec(labels[0].replace(/ /g,''));if(!match)throw new Error('Unrecognised drawn cage label');p.cages.push({cells:group.sort(function(a,b){return a-b;}),target:Number(match[1]),op:match[2]});}}return p;}
 function puzzleUnits(p){var n=p.n,groups=p.regions.slice();for(var r=0;r<n;r++){var row=[],col=[];for(var c=0;c<n;c++){row.push(r*n+c);col.push(c*n+r);}groups.push(row);groups.push(col);}return groups;}
 function solvedVisible(p,values){var n=p.n;if(values.length!==n*n||values.some(function(v){return v<1||v>n||v!==Math.floor(v);}))return false;if(p.givens.some(function(v,i){return v&&values[i]!==v;}))return false;for(var unit of puzzleUnits(p))if(unit.length!==n||new Set(unit.map(function(i){return values[i];})).size!==n)return false;for(var cage of p.cages)if(!cageOK(cage.cells.map(function(i){return values[i];}),cage.target,cage.op))return false;return true;}
 function solveVisible(p){var n=p.n,values=p.givens.slice(),groups=puzzleUnits(p),peers=values.map(function(){return [];});if([3,4,5,9].indexOf(n)<0||values.length!==n*n)throw new Error('Invalid grid dimensions');for(var unit of groups){if(unit.length!==n)throw new Error('Invalid region');var known=unit.map(function(i){return values[i];}).filter(function(v){return v>0;});if(new Set(known).size!==known.length)throw new Error('Conflicting drawn givens');for(var i of unit)for(var j of unit)if(i!==j&&peers[i].indexOf(j)<0)peers[i].push(j);}var cages=[],byCell={};for(var cage of p.cages){var options=[];var enumerate=function(prefix){if(prefix.length===cage.cells.length){if(cageOK(prefix,cage.target,cage.op))options.push(prefix.slice());return;}var index=cage.cells[prefix.length];for(var value=1;value<=n;value++){var duplicate=false;for(var j=0;j<prefix.length;j++)if(prefix[j]===value&&peers[index].indexOf(cage.cells[j])>=0)duplicate=true;if(!duplicate)enumerate(prefix.concat([value]));}};enumerate([]);if(options.length===0)throw new Error('Impossible drawn cage');var index=cages.length;cages.push({cells:cage.cells,options:options});for(var j=0;j<cage.cells.length;j++)byCell[cage.cells[j]]=[index,j];}var candidates=function(cell){var allowed=[];for(var v=1;v<=n;v++)if(!peers[cell].some(function(i){return values[i]===v;}))allowed.push(v);if(byCell[cell]!==undefined){var ref=byCell[cell],cage=cages[ref[0]],possible=cage.options.filter(function(option){return cage.cells.every(function(i,j){return !values[i]||values[i]===option[j];});});allowed=allowed.filter(function(v){return possible.some(function(option){return option[ref[1]]===v;});});}return allowed;};var search=function(){var selected=-1,choices=null;for(var i=0;i<values.length;i++)if(values[i]===0){var possible=candidates(i);if(choices===null||possible.length<choices.length){selected=i;choices=possible;}if(possible.length===0)return null;}if(selected<0)return solvedVisible(p,values)?values.slice():null;for(var value of choices){values[selected]=value;var result=search();if(result!==null)return result;}values[selected]=0;return null;};var result=search();if(result===null)throw new Error('No solution for drawn constraints');return result;}

 function cellAt(index){var n=screen().size,rep=gridRepeater();for(var i=0;i<rep.count;i++){var cell=rep.itemAt(i);if(Math.round(cell.y/cell.height)*n+Math.round(cell.x/cell.width)===index)return cell;}return null;}
 function visibleValues(s,original){var n=original.size,values=new Array(n*n).fill(0),symbols=original.palette.map(function(p){return p.source;});for(var cell of s.cells){var i=Math.round(cell.y/cell.height)*n+Math.round(cell.x/cell.width);if(cell.source)values[i]=arithmetic?Number(cell.source.split('/').pop().replace('.svg','')):symbols.indexOf(cell.source)+1;}return values;}
 function place(index,value,original,kind){var before=visibleValues(screen(),original),palette=original.palette.map(function(p){return p.source;}),selected=value-1;if(arithmetic)selected=palette.findIndex(function(source){return Number(source.split('/').pop().replace('.svg',''))===value;});ensure(selected>=0&&selected<palette.length,'Visible symbol available');if(kind==='key')keyClick(Qt.Key_1+selected);else click(availablePieces.view.itemAtIndex(selected));wait(90);click(cellAt(index));wait(90);var s=screen();return {cell:index,value:value,input:kind,before:before,after:visibleValues(s,original),colors:s.cells.map(function(cell){return cell.color;})};}
 function scoreNumbers(){var text=labels(score).filter(function(text){return /^\d+\/\d+$/.test(text);});compare(text.length,1);return text[0].split('/').map(Number);}
 function wrongAndRepair(original,puzzle,solution){var current=visibleValues(screen(),original),target=-1,value=0,preparation=null;for(var i=0;i<current.length&&target<0;i++)if(!current[i]){for(var peer=0;peer<current.length;peer++)if(current[peer]&&(Math.floor(i/puzzle.n)===Math.floor(peer/puzzle.n)||i%puzzle.n===peer%puzzle.n)){target=i;value=current[peer];break;}}if(target<0){var first=current.indexOf(0);ensure(first>=0);preparation=place(first,solution[first],original,'click');current=preparation.after;for(var i=0;i<current.length&&target<0;i++)if(!current[i]&&(Math.floor(i/puzzle.n)===Math.floor(first/puzzle.n)||i%puzzle.n===first%puzzle.n)){target=i;value=solution[first];}}ensure(target>=0,'A visible conflicting insertion');var attempted=place(target,value,original,'key');ensure(attempted.colors.indexOf('#eb7878')>=0,'Visible rejection highlight');wait(1600);var clearing=null;if(visibleValues(screen(),original)[target]!==0){clearing=place(target,value,original,'click');compare(clearing.after[target],0);}var repair=place(target,solution[target],original,'click');compare(repair.after[target],solution[target]);return {preparation:preparation,attempt:attempted,clearing:clearing,repair:repair};}

 function test_help(){wait(1900);evidence.selection=chooseDataset(0);var depth=pageView.depth;icon('bar_help.svg');tryCompare(pageView,'depth',depth+1);var help=pageView.currentItem;evidence.title=String(help.title);evidence.content=String(help.content);grabImage(pageView).save('__QA_OUTPUT__/help.png');compare(help.title,arithmetic?'Calcudoku':'Sudoku');ensure(help.content.indexOf('linha')>=0&&help.content.indexOf('coluna')>=0);if(arithmetic)ensure(help.content.indexOf('operador')>=0);else{ensure(help.content.indexOf('deve aparecem')<0,'Infinitive after deve');ensure(help.content.indexOf('deve aparecer apenas uma vez')>=0,'PT instruction uses infinitive');}keyClick(Qt.Key_Escape);tryCompare(pageView,'depth',depth);wait(1900);var original=screen(),puzzle=visiblePuzzle(original,arithmetic),solution=solveVisible(puzzle),cell=puzzle.givens.indexOf(0);ensure(cell>=0);evidence.afterHelp=original;evidence.input=place(cell,solution[cell],original,'key');compare(evidence.input.after[cell],solution[cell]);grabImage(pageView).save('__QA_OUTPUT__/focus.png');evidence.focusAfterHelp=true;}
