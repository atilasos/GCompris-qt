TestCase {
 name:'OfferedGridDatasetsAndVisibleGeometry'
 when:activity.visible&&boardItem.width>0
 property var evidence: ({datasets:[],records:[]})
 function ensure(value,message){if(!value){console.log('GRIDS_ASSERT',message||'',new Error().stack);grabImage(pageView).save('__QA_OUTPUT__/failure.png');}verify(value,message||'');}
 property bool arithmetic: true
 property var boardItem: calcudokuColumn
 function find(root,predicate){if(predicate(root))return root;if(root.children)for(var child of root.children){var value=find(child,predicate);if(value)return value;}return null;}
 function collect(root,predicate){var result=[];if(predicate(root))result.push(root);if(root.children)for(var child of root.children)result=result.concat(collect(child,predicate));return result;}
 function drawn(item){var alpha=1;for(var p=item;p&&p!==pageView;p=p.parent){if(!p.visible)return false;if(p.opacity!==undefined)alpha*=p.opacity;}return alpha>0.9&&item.width>0&&item.height>0;}
 function click(item){ensure(item!==null);ensure(drawn(item));var p=item.mapToItem(pageView,item.width/2,item.height/2);ensure(p.x>=0&&p.x<pageView.width&&p.y>=0&&p.y<pageView.height,'Clickable inside viewport');mouseClick(pageView,p.x,p.y,Qt.LeftButton,Qt.NoModifier,0);}
 function icon(suffix){wait(1800);var item=find(bar,function(node){return node.source!==undefined&&String(node.source).endsWith(suffix)&&drawn(node);});ensure(item!==null,'Visible icon '+suffix);click(item);wait(1800);}
 function labels(root){return collect(root,function(item){return item.font!==undefined&&item.text!==undefined&&drawn(item)&&String(item.text)!=='';}).map(function(item){return String(item.text);});}
 function configBoxes(){return collect(dialogActivityConfig,function(item){return item.checked!==undefined&&item.indicatorImageHeight!==undefined&&item.text!==undefined&&drawn(item);});}
 function openConfig(){if(!dialogActivityConfig.visible)icon('bar_activity_config.svg');tryCompare(dialogActivityConfig,'visible',true);wait(900);}
 function chooseDataset(index){openConfig();var boxes=configBoxes();ensure(index>=0&&index<boxes.length,'Offered dataset');var target=boxes[index];if(!target.checked)click(target);for(var item of boxes)if(item!==target&&item.checked)click(item);ensure(target.checked);ensure(boxes.filter(function(item){return item.checked;}).length===1);var selected=boxes.map(function(item){return {label:String(item.text),checked:item.checked};});var save=find(dialogActivityConfig,function(item){return item.text==='Gravar'&&item.clicked!==undefined&&drawn(item);});ensure(save!==null);click(save);tryCompare(dialogActivityConfig,'visible',false);wait(1900);return selected;}
 function gridRepeater(){var value=find(boardItem,function(item){return item.itemAt!==undefined&&item.count!==undefined;});ensure(value!==null);return value;}
 function imageSource(item){var image=find(item,function(node){return node.source!==undefined&&drawn(node)&&String(node.source).endsWith('.svg');});if(image){tryCompare(image,'status',1,2500);return String(image.source);}return '';}
 function screen(){var rep=gridRepeater(),cells=[],palette=[],regions=[],cages=[],size=0;for(var i=0;i<rep.count;i++){var cell=rep.itemAt(i);ensure(drawn(cell));var p=cell.mapToItem(boardItem,0,0);cells.push({x:p.x,y:p.y,width:cell.width,height:cell.height,source:imageSource(cell),color:String(cell.color),labels:labels(cell)});size=Math.max(size,Math.round(p.x/cell.width)+1);}for(var i=0;i<availablePieces.view.count;i++){var piece=availablePieces.view.itemAtIndex(i);ensure(piece!==null);ensure(drawn(piece));palette.push({source:imageSource(piece),x:piece.x,y:piece.y,width:piece.width,height:piece.height});}if(!arithmetic&&regionGrid.visible){for(var i=0;i<regionRepeater.count;i++){var box=regionRepeater.itemAt(i);if(drawn(box))regions.push({x:box.x,y:box.y,width:box.width,height:box.height});}}if(arithmetic){var repC=find(calcudokuCages,function(item){return item.itemAt!==undefined&&item.count!==undefined;});ensure(repC!==null);for(var i=0;i<repC.count;i++){var cage=repC.itemAt(i),walls=[];for(var wall of cage.children)if(drawn(wall)&&wall.color!==undefined){walls.push({x:wall.x,y:wall.y,width:wall.width,height:wall.height,color:String(wall.color)});}cages.push({x:cage.x,y:cage.y,width:cage.width,height:cage.height,walls:walls});}}var scoreText=labels(score);return {level:bar.level,publicLevels:activity.numberOfLevel,cells:cells,size:size,palette:palette,regions:regions,cages:cages,score:scoreText};}

 function test_inventory(){wait(1900);openConfig();var boxes=configBoxes();ensure(boxes.length>0);evidence.datasets=boxes.map(function(item){return {label:String(item.text),checked:item.checked};});grabImage(pageView).save('__QA_OUTPUT__/datasets.png');var count=boxes.length;var cancel=find(dialogActivityConfig,function(item){return item.text==='Cancelar'&&item.clicked!==undefined&&drawn(item);});ensure(cancel!==null);click(cancel);tryCompare(dialogActivityConfig,'visible',false);for(var dataset=0;dataset<count;dataset++){var selected=chooseDataset(dataset);var number=activity.numberOfLevel;ensure(number>0);for(var level=1;level<=number;level++){compare(bar.level,level);var current=screen();current.dataset=dataset+1;current.selection=selected;evidence.records.push(current);grabImage(pageView).save('__QA_OUTPUT__/dataset-'+(dataset+1)+'-level-'+level+'.png');console.log('GRIDS_INVENTORY',arithmetic?'calcudoku':'sudoku',dataset+1,count,level,number,current.size,current.score);icon('bar_next.svg');}compare(bar.level,1);}}
 function cleanupTestCase(){console.log('NATIVE_GRIDS_RESULT',JSON.stringify({failures:qtest_results.failCount,passes:qtest_results.passCount,evidence:evidence}));}
}
